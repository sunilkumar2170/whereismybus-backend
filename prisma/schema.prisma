}).setView([26.9124,75.7873],15);
map.zoomControl.setPosition('bottomleft');

L.tileLayer('https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}&hl=en&scale=2',{
  subdomains:['0','1','2','3'],maxZoom:21,
  updateWhenIdle:false,updateWhenZooming:false,
  keepBuffer:8,detectRetina:true,attribution:'\u00a9 Google Maps'
}).addTo(map);

var stopsLayer=L.layerGroup().addTo(map);
var routeLayer=L.layerGroup().addTo(map);
var arrowsLayer=L.layerGroup().addTo(map);
var turnsLayer=L.layerGroup().addTo(map);
var driverToFirstLayer=L.layerGroup().addTo(map);

// ── bearing between two lat/lng points, in degrees (0=N,90=E,180=S,270=W) ──
function bearingDeg(lat1,lng1,lat2,lng2){
  var toRad=function(d){return d*Math.PI/180;};
  var toDeg=function(r){return r*180/Math.PI;};
  var y=Math.sin(toRad(lng2-lng1))*Math.cos(toRad(lat2));
  var x=Math.cos(toRad(lat1))*Math.sin(toRad(lat2))-Math.sin(toRad(lat1))*Math.cos(toRad(lat2))*Math.cos(toRad(lng2-lng1));
  return (toDeg(Math.atan2(y,x))+360)%360;
}

// ── small chevron arrows along whatever route line is currently drawn
// (road-snapped if available, straight-line fallback otherwise) —
// spaced by real-world distance so long stretches get more arrows. ──
function drawRouteArrows(coords){
  arrowsLayer.clearLayers();
  if(!coords||coords.length<2) return;
  for(var i=0;i<coords.length-1;i++){
    var a=coords[i], b=coords[i+1];
    var segDist=map.distance(a,b);
    if(segDist<8) continue; // skip near-duplicate points from dense OSRM geometry
    var brng=bearingDeg(a[0],a[1],b[0],b[1]);
    var arrowCount=Math.max(1,Math.min(3,Math.floor(segDist/140)));
    for(var k=1;k<=arrowCount;k++){
      var f=k/(arrowCount+1);
      var lat=a[0]+(b[0]-a[0])*f;
      var lng=a[1]+(b[1]-a[1])*f;
      var icon=L.divIcon({
        html:'<div class="dirArrow" style="width:22px;height:22px;transform:rotate('+brng+'deg)">'
          +'<svg width="22" height="22" viewBox="0 0 24 24">'
          +'<path d="M12 3 L19 19 L12 15 L5 19 Z" fill="#1A73E8" stroke="#ffffff" stroke-width="1.6" stroke-linejoin="round"/>'
          +'<\/svg><\/div>',
        className:'',iconSize:[22,22],iconAnchor:[11,11]
      });
      L.marker([lat,lng],{icon:icon,interactive:false,zIndexOffset:250}).addTo(arrowsLayer);
    }
  }
}

// ── stop markers only (start/end/waypoints) — called once per admin
// stop-list load. Does NOT draw the connecting line; that's drawn
// separately by drawRoadRoute (road-snapped) or setRouteFallbackLine
// (straight, only used if the routing API fails). ──
window.initStops=function(stopsJson){
  stopsLayer.clearLayers();
  var stops=JSON.parse(stopsJson);
  if(!stops||!stops.length) return;
  stops.forEach(function(s,i){
    var isFirst=(i===0),isLast=(i===stops.length-1);
    var col=isFirst?'#34A853':isLast?'#EA4335':'#1A73E8', r=isFirst?12:isLast?13:8;
    L.circleMarker([parseFloat(s.lat),parseFloat(s.lng)],{radius:r,fillColor:col,color:'#fff',weight:3,fillOpacity:1,pane:'markerPane'})
     .addTo(stopsLayer).bindPopup('<div style="padding:9px 13px;font-size:14px;font-weight:bold;color:'+col+'">'+(isFirst?'\u{1F7E2} ':isLast?'\u{1F3EB} ':'\u{1F4CD} ')+s.name+'</div>',{closeButton:false,offset:[0,-6]});
    if(isFirst){
      L.marker([parseFloat(s.lat),parseFloat(s.lng)],{icon:L.divIcon({html:'<div style="background:#34A853;color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:8px;white-space:nowrap;box-shadow:0 2px 8px rgba(52,168,83,0.45);margin-top:18px">START<\/div>',className:'',iconSize:[52,22],iconAnchor:[26,-5]}),interactive:false,zIndexOffset:400}).addTo(stopsLayer);
    }
  });
};

// ── the ACTUAL road-snapped route (from OSRM), drawn as the primary
// route line. Call drawRouteArrows with the same coords right after. ──
window.drawRoadRoute=function(coordsJson){
  routeLayer.clearLayers();
  var coords=JSON.parse(coordsJson);
  if(!coords||coords.length<2) return;
  L.polyline(coords,{color:'#a8c7fa',weight:14,opacity:0.35,lineJoin:'round',lineCap:'round'}).addTo(routeLayer);
  L.polyline(coords,{color:'#1A73E8',weight:6,opacity:0.95,lineJoin:'round',lineCap:'round',smoothFactor:1}).addTo(routeLayer);
  drawRouteArrows(coords);
};

// ── straight stop-to-stop fallback line, used ONLY when the road
// routing API is unreachable — so there's still a visible route. ──
window.setRouteFallbackLine=function(coordsJson){
  routeLayer.clearLayers();
  var coords=JSON.parse(coordsJson);
  if(!coords||coords.length<2) return;
  L.polyline(coords,{color:'#a8c7fa',weight:10,opacity:0.3,dashArray:'2,10',lineJoin:'round',lineCap:'round'}).addTo(routeLayer);
  L.polyline(coords,{color:'#1A73E8',weight:4,opacity:0.85,dashArray:'2,10',lineJoin:'round',lineCap:'round'}).addTo(routeLayer);
  drawRouteArrows(coords);
};

// ── LEFT/RIGHT turn badges at the real road maneuver points OSRM
// returns (empty array = none, e.g. fallback mode). ──
window.drawTurnBadges=function(stepsJson){
  turnsLayer.clearLayers();
  var steps=JSON.parse(stepsJson);
  if(!steps||!steps.length) return;
  steps.forEach(function(st){
    var dir=(st.modifier||'').indexOf('left')!==-1?'left':'right';
    var label=dir==='left'?'\u2B05 LEFT':'RIGHT \u27A1';
    var col=dir==='left'?'#8B5CF6':'#FF9800';
    var icon=L.divIcon({
      html:'<div style="background:'+col+';color:#fff;font-size:11px;font-weight:800;padding:5px 10px;border-radius:10px;white-space:nowrap;box-shadow:0 3px 10px rgba(0,0,0,0.4);border:2px solid #fff">'+label+'<\/div>',
      className:'',iconSize:[80,28],iconAnchor:[40,48]
    });
    L.marker([st.lat,st.lng],{icon:icon,interactive:false,zIndexOffset:600}).addTo(turnsLayer);
  });
};

window.setOffRoute=function(v){
  var el=document.getElementById('offRouteBanner');
  if(el) el.style.display = v ? 'block' : 'none';
};

window.drawDriverToFirst=function(dLat,dLng,fLat,fLng){
  driverToFirstLayer.clearLayers();
  L.polyline([[dLat,dLng],[fLat,fLng]],{color:'#00D4AA',weight:4,opacity:0.85,dashArray:'10,8',lineJoin:'round',lineCap:'round'}).addTo(driverToFirstLayer);
};
window.clearDriverToFirst=function(){ driverToFirstLayer.clearLayers(); };

var driverIcon=L.divIcon({
  html:'<div style="position:relative;width:46px;height:46px">'
    +'<div style="position:absolute;width:68px;height:68px;border-radius:50%;background:rgba(0,212,170,0.2);margin-left:-11px;margin-top:-11px;animation:pulse 2s ease-out infinite;pointer-events:none"></div>'
    +'<div id="busWrap" style="background:#0A0F1C;border:3.5px solid #00D4AA;border-radius:50%;width:46px;height:46px;display:flex;align-items:center;justify-content:center;box-shadow:0 5px 20px rgba(0,212,170,0.5);position:relative;z-index:2;font-size:23px;transition:transform 0.5s ease">\u{1F68C}<\/div>'
    +'<div id="spd" style="position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);background:#00D4AA;color:#0A0F1C;font-size:10px;font-weight:700;border-radius:7px;padding:2px 7px;white-space:nowrap;box-shadow:0 2px 6px rgba(0,212,170,0.4);transition:background 0.3s">Stopped<\/div>'
    +'</div>',
  className:'',iconSize:[46,70],iconAnchor:[23,23]
});

var curLat=26.9124,curLng=75.7873;
var driverMarker=L.marker([curLat,curLng],{icon:driverIcon,zIndexOffset:3000,keyboard:false})
  .addTo(map).bindPopup('<div style="padding:9px 13px"><div style="font-size:14px;font-weight:bold;color:#00D4AA">\u{1F68C} Your Location<\/div><\/div>',{closeButton:false,offset:[0,-48]});

var animId=null,tgtLat=curLat,tgtLng=curLng,following=true;
function easeOut(t){return 1-Math.pow(1-t,3);}
function animDriver(){
  if(animId){cancelAnimationFrame(animId);animId=null;}
  var sLat=curLat,sLng=curLng,eLat=tgtLat,eLng=tgtLng;
  var dist=Math.sqrt(Math.pow(eLat-sLat,2)+Math.pow(eLng-sLng,2));
  if(dist>0.02){curLat=eLat;curLng=eLng;driverMarker.setLatLng([curLat,curLng]);if(following)map.panTo([curLat,curLng],{animate:false});return;}
  var t0=null,dur=1200;
  function step(ts){
    if(!t0)t0=ts;
    var p=Math.min((ts-t0)/dur,1),e=easeOut(p);
    curLat=sLat+(eLat-sLat)*e;curLng=sLng+(eLng-sLng)*e;
    driverMarker.setLatLng([curLat,curLng]);
    if(p<1){animId=requestAnimationFrame(step);}
    else{curLat=eLat;curLng=eLng;animId=null;}
  }
  animId=requestAnimationFrame(step);
  if(following)map.panTo([eLat,eLng],{animate:true,duration:1.1,easeLinearity:0.2,noMoveStart:true});
}
map.on('dragstart',function(){following=false;});
function locateMe(){following=true;map.flyTo([curLat,curLng],17,{animate:true,duration:0.8});}

window.driverMove=function(lat,lng,spd,heading){
  tgtLat=parseFloat(lat);tgtLng=parseFloat(lng);
  var s=Math.max(0,parseInt(spd)||0);
  var el=document.getElementById('spd');
  if(el){el.textContent=s>0?s+' km\/h':'Stopped';el.style.background=s>60?'#F44336':s>40?'#FF9800':'#00D4AA';el.style.color=s>40?'#fff':'#0A0F1C';}
  if(heading!=null&&!isNaN(heading)&&s>2){var w=document.getElementById('busWrap');if(w)w.style.transform='rotate('+heading+'deg)';}
  animDriver();
};
map.whenReady(function(){setTimeout(function(){map.invalidateSize({animate:false});},250);});
<\/script>
</body>
</html>`;

export default function DriverScreen({ user, onLogout }) {
  const [tripStarted,  setTripStarted]  = useState(false);
  const [startingTrip, setStartingTrip] = useState(false); // double tap block
  const [speed,        setSpeed]        = useState(0);
  const [sosActive,    setSosActive]    = useState(false);
  const [connected,    setConnected]    = useState(false);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [tripTime,     setTripTime]     = useState(0);
  const [accuracy,     setAccuracy]     = useState(null);
  const [updateCount,  setUpdateCount]  = useState(0);
  const [bgActive,     setBgActive]     = useState(false);
  const [route,        setRoute]        = useState(null);   // { id, name, stops:[...] }

  // ── Bus lookup (fixes the "shows UUID / always No Bus Assigned" bug) ──
  // user.busId is actually Driver.busId, which is a Bus.id (UUID) — NOT
  // a human bus number. We fetch the Bus record and read bus.busNo for
  // display, while busId itself keeps being used for route/stops/GPS
  // lookups (that part was already correct).
  const [busInfo,        setBusInfo]        = useState(null);  // { id, busNo, status } | null
  const [busFetchFailed, setBusFetchFailed]  = useState(false);

  // ── Turn-by-turn / progress state ──
  const [stopProgress, setStopProgress] = useState({ done: 0, total: 0 });
  const [nextStopInfo, setNextStopInfo] = useState(null); // { name, distM, etaMin }
  const [nextTurn,     setNextTurn]     = useState(null); // { modifier, distM }
  const [offRoute,     setOffRoute]     = useState(false);
  const [routeMode,    setRouteMode]    = useState('none'); // 'road' | 'fallback' | 'none'

  const busId = user?.busId || null;

  const socketRef     = useRef(null);
  const locationSub   = useRef(null);
  const timerRef       = useRef(null);
  const webViewRef    = useRef(null);
  const fsWebViewRef  = useRef(null);
  const lastPos       = useRef({ lat: 26.9124, lng: 75.7873, speed: 0 });
  const appStateRef   = useRef(AppState.currentState);
  const stopsRef       = useRef([]);
  const tripActiveRef  = useRef(false);
  const busIdRef       = useRef(busId);

  const roadRouteCoordsRef  = useRef([]); // [[lat,lng],...] currently-drawn route (road or fallback)
  const roadStepsRef        = useRef([]); // [{lat,lng,modifier,distance}]
  const currentStopIndexRef = useRef(0);
  const currentStepIndexRef = useRef(0);
  const lastRecalcRef       = useRef(0);
  const offRouteCounterRef  = useRef(0);

  useEffect(() => { busIdRef.current = busId; _bgBusId = busId || 'BUS001'; }, [busId]);

  console.log('[DRIVER] Logged in user:', user);
  console.log('[DRIVER] Driver name:', user?.name);
  console.log('[DRIVER] Driver busId:', user?.busId);

  // ── Socket ──
  useEffect(() => {
    socketRef.current = io(SOCKET_URL, {
      transports: ['websocket'],
      reconnection: true,
      reconnectionDelay: 500,
      reconnectionAttempts: Infinity,
    });
    socketRef.current.on('connect', () => {
      setConnected(true);
      // ✅ Driver apne bus ke room mein join karta hai
      // Isse backend sirf isi bus ke room ko GPS/notification bhejega,
      // poore server ko broadcast nahi karega — multi-bus privacy fix
      socketRef.current.emit('joinAsDriver', { busId: busIdRef.current });
      console.log('Driver joined room for bus:', busIdRef.current);
    });
    socketRef.current.on('disconnect', () => setConnected(false));
    _bgSocket = socketRef.current;
    _bgBusId  = busIdRef.current || 'BUS001';
    fetchRoute();
    fetchBusDetails();
    return () => {
      _bgSocket = null;
      socketRef.current?.disconnect();
    };
  }, []);

  // ── Fetch the Bus record for this driver's busId, so we can show
  // the actual busNo instead of the raw UUID. Uses the existing
  // GET /api/buses list endpoint (no new backend route needed) and
  // matches by id client-side. ──
  const fetchBusDetails = useCallback(async () => {
    const id = busIdRef.current;
    if (!id) { setBusInfo(null); setBusFetchFailed(false); return; }
    try {
      const token = await getToken();
      const res = await axios.get(`${API}/api/buses`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const buses = res.data?.buses || [];
      const match = buses.find(b => b.id === id);
      console.log('[DRIVER] Assigned bus:', match);
      console.log('[DRIVER] Bus number:', match?.busNo || match?.bus_no);
      if (match) { setBusInfo(match); setBusFetchFailed(false); }
      else { setBusInfo(null); setBusFetchFailed(true); }
    } catch (e) {
      console.log('[DRIVER] bus fetch error:', e.message);
      setBusInfo(null);
      setBusFetchFailed(true);
    }
  }, []);

  // ── Fetch Route (admin-assigned Stops for THIS driver's bus, in
  // admin-defined order) — and kick off the road-route fetch once
  // stops are known. ──
  const fetchRoute = useCallback(async () => {
    try {
      const token = await getToken();
      const r = await getRouteByBus(busIdRef.current, token);
      setRoute(r);
      const stops = r?.stops || [];
      stopsRef.current = stops;
      console.log('[DRIVER] assigned busId:', busIdRef.current);
      console.log('[DRIVER] assigned route:', r);
      console.log('[DRIVER] ADMIN ASSIGNED STOPS:', stops);
      console.log('[DRIVER] stops count:', stops.length);
      currentStopIndexRef.current = 0;
      setStopProgress({ done: 0, total: stops.length });
      if (stops.length) {
        const js = `window.initStops(${JSON.stringify(JSON.stringify(stops))}); true;`;
        webViewRef.current?.injectJavaScript(js);
        fsWebViewRef.current?.injectJavaScript(js);
        fetchRoadRoute(stops, { force: true });
      }
    } catch (e) { console.log('route err:', e); }
  }, []);

  // ── Road-snapped route via OSRM (real road geometry + turn-by-turn
  // steps), throttled so we don't hammer the API on every GPS ping —
  // only called on stop-list load, trip start, or confirmed deviation. ──
  const fetchRoadRoute = useCallback(async (stopsArr, { force = false } = {}) => {
    if (!stopsArr || stopsArr.length < 2) return;
    const now = Date.now();
    if (!force && now - lastRecalcRef.current < RECALC_COOLDOWN_MS) return;
    lastRecalcRef.current = now;
    try {
      const coordStr = stopsArr.map(s => `${s.lng},${s.lat}`).join(';');
      const url = `${OSRM_ROUTE_URL}${coordStr}?overview=full&geometries=geojson&steps=true`;
      const res = await fetch(url);
      const data = await res.json();
      if (data.code === 'Ok' && data.routes?.length) {
        const routeData = data.routes[0];
        const coords = routeData.geometry.coordinates.map(([lng, lat]) => [lat, lng]);
        const steps = [];
        routeData.legs.forEach(leg => {
          leg.steps.forEach(step => {
            const m = step.maneuver;
            if (m?.modifier && /left|right/.test(m.modifier) && step.distance > 15) {
              steps.push({ lat: m.location[1], lng: m.location[0], modifier: m.modifier, distance: step.distance });
            }
          });
        });
        roadRouteCoordsRef.current = coords;
        roadStepsRef.current = steps;
        currentStepIndexRef.current = 0;
        setRouteMode('road');
        const js = `window.drawRoadRoute(${JSON.stringify(JSON.stringify(coords))}); window.drawTurnBadges(${JSON.stringify(JSON.stringify(steps))}); true;`;
        webViewRef.current?.injectJavaScript(js);
        fsWebViewRef.current?.injectJavaScript(js);
      } else {
        throw new Error('OSRM returned no route');
      }
    } catch (e) {
      console.log('[DRIVER] road route fetch failed, using straight-line fallback:', e.message);
      const coords = stopsArr.map(s => [s.lat, s.lng]);
      roadRouteCoordsRef.current = coords;
      roadStepsRef.current = [];
      currentStepIndexRef.current = 0;
      setRouteMode('fallback');
      const js = `window.setRouteFallbackLine(${JSON.stringify(JSON.stringify(coords))}); window.drawTurnBadges(${JSON.stringify(JSON.stringify([]))}); true;`;
      webViewRef.current?.injectJavaScript(js);
      fsWebViewRef.current?.injectJavaScript(js);
    }
  }, []);

  // ── AppState listener ──
  useEffect(() => {
    const sub = AppState.addEventListener('change', async (nextState) => {
      const prev = appStateRef.current;
      appStateRef.current = nextState;
      if (!tripActiveRef.current) return;

      if (prev === 'active' && nextState === 'background') {
        console.log('[AppState] → Background');
        if (locationSub.current) {
          locationSub.current.remove();
          locationSub.current = null;
        }
        setBgActive(true);
      } else if (prev.match(/inactive|background/) && nextState === 'active') {
        console.log('[AppState] → Foreground');
        setBgActive(false);
        startForegroundWatcher();
      }
    });
    return () => sub.remove();
  }, []);

  // ── Start foreground GPS watcher ──
  const startForegroundWatcher = useCallback(async () => {
    if (locationSub.current) return;
    try {
      locationSub.current = await Location.watchPositionAsync(
        {
          accuracy        : Location.Accuracy.BestForNavigation,
          timeInterval    : 1000,
          distanceInterval: 0,
        },
        (loc) => {
          const { latitude, longitude, speed: spd, heading, accuracy: acc } = loc.coords;
          const kmh = spd != null && spd >= 0 ? Math.round(spd * 3.6) : 0;
          setSpeed(kmh);
          setAccuracy(acc ? Math.round(acc) : null);
          setUpdateCount(c => c + 1);
          lastPos.current = { lat: latitude, lng: longitude, speed: kmh };
          inject(latitude, longitude, kmh, heading);
          drawDriverToFirst(latitude, longitude);
          socketRef.current?.emit('sendLocation', {
            busId: busIdRef.current, lat: latitude, lng: longitude, speed: kmh, heading,
          });

          // ── auto next-stop (sequential — only ever moves forward) ──
          const stopsArr = stopsRef.current;
          if (stopsArr.length) {
            const idx = Math.min(currentStopIndexRef.current, stopsArr.length - 1);
            const target = stopsArr[idx];
            const d = distMeters(latitude, longitude, target.lat, target.lng);
            if (d < STOP_ARRIVAL_RADIUS_M && idx < stopsArr.length - 1) {
              currentStopIndexRef.current = idx + 1;
            }
            const newIdx = currentStopIndexRef.current;
            const newTarget = stopsArr[newIdx] || stopsArr[stopsArr.length - 1];
            const dNew = distMeters(latitude, longitude, newTarget.lat, newTarget.lng);
            setStopProgress({ done: newIdx, total: stopsArr.length });
            setNextStopInfo({
              name: newTarget.name,
              distM: Math.round(dNew),
              etaMin: kmh > 2 ? Math.max(1, Math.round((dNew / 1000) / kmh * 60)) : null,
            });
          }

          // ── auto next-turn (left/right, from real road maneuvers) ──
          const stepsArr = roadStepsRef.current;
          if (stepsArr.length) {
            const sIdx = Math.min(currentStepIndexRef.current, stepsArr.length - 1);
            const st = stepsArr[sIdx];
            const dTurn = distMeters(latitude, longitude, st.lat, st.lng);
            if (dTurn < TURN_ARRIVAL_RADIUS_M && sIdx < stepsArr.length - 1) {
              currentStepIndexRef.current = sIdx + 1;
            }
            const nIdx = currentStepIndexRef.current;
            const nSt = stepsArr[nIdx];
            if (nSt) {
              const dNewTurn = distMeters(latitude, longitude, nSt.lat, nSt.lng);
              setNextTurn({ modifier: nSt.modifier, distM: Math.round(dNewTurn) });
            } else {
              setNextTurn(null);
            }
          } else {
            setNextTurn(null);
          }

          // ── off-route detection (throttled recalculation) ──
          if (roadRouteCoordsRef.current.length) {
            const distOff = distToPolylineMeters(latitude, longitude, roadRouteCoordsRef.current);
            if (distOff > OFF_ROUTE_THRESHOLD_M) {
              offRouteCounterRef.current += 1;
              if (offRouteCounterRef.current >= OFF_ROUTE_CONFIRM_PINGS) {
                setOffRoute(true);
                webViewRef.current?.injectJavaScript(`window.setOffRoute(true); true;`);
                fsWebViewRef.current?.injectJavaScript(`window.setOffRoute(true); true;`);
                fetchRoadRoute(stopsRef.current); // internally throttled
              }
            } else {
              offRouteCounterRef.current = 0;
              setOffRoute(prev => {
                if (prev) {
                  webViewRef.current?.injectJavaScript(`window.setOffRoute(false); true;`);
                  fsWebViewRef.current?.injectJavaScript(`window.setOffRoute(false); true;`);
                }
                return false;
              });
            }
          }
        }
      );
    } catch (e) {
      console.log('[FG Watcher] Error:', e.message);
    }
  }, [fetchRoadRoute]);

  // ── Start background task — app band hone pe bhi chale ──
  const startBgTask = async () => {
    try {
      const isRunning = await Location.hasStartedLocationUpdatesAsync(LOCATION_TASK).catch(() => false);
      if (isRunning) return;
      _bgBusId = busIdRef.current || 'BUS001';
      await Location.startLocationUpdatesAsync(LOCATION_TASK, {
        accuracy          : Location.Accuracy.Balanced,
        timeInterval      : 4000,
        distanceInterval  : 5,
        foregroundService : {
          notificationTitle  : '🚌 Where Is My Bus',
          notificationBody   : `Trip active on ${busInfo?.busNo || busIdRef.current} — sharing location`,
          notificationColor  : '#00D4AA',
          sticky: true,
        },
        pausesUpdatesAutomatically      : false,
        showsBackgroundLocationIndicator: true,
        activityType: Location.ActivityType.AutomotiveNavigation,
      });
      console.log('[BG Task] Started ✅ for', busIdRef.current);
    } catch (e) {
      console.log('[BG Task] Start failed:', e.message);
    }
  };

  // ── Stop background task ──
  const stopBgTask = async () => {
    try {
      const isRunning = await Location.hasStartedLocationUpdatesAsync(LOCATION_TASK).catch(() => false);
      if (isRunning) {
        await Location.stopLocationUpdatesAsync(LOCATION_TASK);
        console.log('[BG Task] Stopped ✅');
      }
    } catch (e) {
      console.log('[BG Task] Stop failed:', e.message);
    }
  };

  // ── Inject to both WebViews ──
  const inject = useCallback((lat, lng, spd, heading) => {
    const hdg = (heading != null && !isNaN(heading)) ? heading : 'null';
    const js  = `window.driverMove(${lat},${lng},${spd},${hdg}); true;`;
    webViewRef.current?.injectJavaScript(js);
    fsWebViewRef.current?.injectJavaScript(js);
  }, []);

  const drawDriverToFirst = useCallback((lat, lng) => {
    if (!stopsRef.current.length) return;
    const first = stopsRef.current[0];
    const js = `window.drawDriverToFirst(${lat},${lng},${parseFloat(first.lat)},${parseFloat(first.lng)}); true;`;
    webViewRef.current?.injectJavaScript(js);
    fsWebViewRef.current?.injectJavaScript(js);
  }, []);

  const onMapLoad = useCallback(() => {
    const { lat, lng, speed: spd } = lastPos.current;
    setTimeout(() => {
      webViewRef.current?.injectJavaScript(`window.driverMove(${lat},${lng},${spd},null); true;`);
      if (stopsRef.current.length) {
        webViewRef.current?.injectJavaScript(`window.initStops(${JSON.stringify(JSON.stringify(stopsRef.current))}); true;`);
      }
      if (roadRouteCoordsRef.current.length) {
        const fn = routeMode === 'road' ? 'drawRoadRoute' : 'setRouteFallbackLine';
        webViewRef.current?.injectJavaScript(`window.${fn}(${JSON.stringify(JSON.stringify(roadRouteCoordsRef.current))}); window.drawTurnBadges(${JSON.stringify(JSON.stringify(roadStepsRef.current))}); true;`);
      }
    }, 700);
  }, [routeMode]);

  const onFsMapLoad = useCallback(() => {
    const { lat, lng, speed: spd } = lastPos.current;
    setTimeout(() => {
      fsWebViewRef.current?.injectJavaScript(`window.driverMove(${lat},${lng},${spd},null); true;`);
      if (stopsRef.current.length) {
        fsWebViewRef.current?.injectJavaScript(`window.initStops(${JSON.stringify(JSON.stringify(stopsRef.current))}); true;`);
      }
      if (roadRouteCoordsRef.current.length) {
        const fn = routeMode === 'road' ? 'drawRoadRoute' : 'setRouteFallbackLine';
        fsWebViewRef.current?.injectJavaScript(`window.${fn}(${JSON.stringify(JSON.stringify(roadRouteCoordsRef.current))}); window.drawTurnBadges(${JSON.stringify(JSON.stringify(roadStepsRef.current))}); true;`);
      }
    }, 700);
  }, [routeMode]);

  // ── START TRIP ──
  const startTrip = useCallback(async () => {
    if (startingTrip || tripStarted) return; // double tap block
    setStartingTrip(true);

    const { status: fg } = await Location.requestForegroundPermissionsAsync();
    if (fg !== 'granted') {
      Alert.alert('Permission Required', 'Location permission is required to start trip.');
      setStartingTrip(false);
      return;
    }

    const { status: bg } = await Location.requestBackgroundPermissionsAsync();
    if (bg !== 'granted') {
      Alert.alert(
        '⚠️ Important!',
        'Background location chahiye taaki app band hone pe bhi tracking ho.\n\nSettings → Apps → Where Is My Bus → Permissions → Location → "Allow all the time" select karo',
        [{ text: 'OK' }]
      );
    }

    setTripStarted(true);
    setTripTime(0);
    setUpdateCount(0);
    setBgActive(false);
    tripActiveRef.current = true;
    setStartingTrip(false);

    // fresh trip → reset navigation progress from the top
    currentStopIndexRef.current = 0;
    currentStepIndexRef.current = 0;
    offRouteCounterRef.current = 0;
    setOffRoute(false);
    setStopProgress({ done: 0, total: stopsRef.current.length });
    setNextStopInfo(null);
    setNextTurn(null);
    if (stopsRef.current.length >= 2) fetchRoadRoute(stopsRef.current, { force: true });

    timerRef.current = setInterval(() => setTripTime(t => t + 1), 1000);

    // Backend ko batao trip start hui — Bus status ON_TRIP ho jaaye
    try {
      const token = await getToken();
      await axios.post(`${API}/api/trips/start`,
        { busId: busIdRef.current },
        { headers: { Authorization: `Bearer ${token}` } }
      );
    } catch (e) { console.log('trip start api:', e.message); }

    await startBgTask();
    await startForegroundWatcher();

  }, [startingTrip, tripStarted, startForegroundWatcher, fetchRoadRoute]);

  // ── STOP TRIP ──
  const stopTrip = useCallback(async () => {
    tripActiveRef.current = false;
    setTripStarted(false);
    setSosActive(false);
    setSpeed(0);
    setTripTime(0);
    setAccuracy(null);
    setUpdateCount(0);
    setBgActive(false);
    setOffRoute(false);
    setNextTurn(null);

    webViewRef.current?.injectJavaScript(`window.clearDriverToFirst(); window.setOffRoute(false); true;`);
    fsWebViewRef.current?.injectJavaScript(`window.clearDriverToFirst(); window.setOffRoute(false); true;`);

    if (locationSub.current) {
      locationSub.current.remove();
      locationSub.current = null;
    }
    if (timerRef.current) {
      clearInterval(timerRef.current);
      timerRef.current = null;
    }

    await stopBgTask();

    try {
      const token = await getToken();
      await axios.post(`${API}/api/trips/end`,
        { busId: busIdRef.current },
        { headers: { Authorization: `Bearer ${token}` } }
      );
    } catch (e) { console.log('trip end api:', e.message); }
  }, []);

  // ── SOS — Notification bhi bhejo ──
  const triggerSOS = useCallback(async () => {
    const next = !sosActive;
    setSosActive(next);

    socketRef.current?.emit('sos', {
      busId: busIdRef.current, driverName: user?.name || 'Driver', message: 'SOS Emergency!',
    });

    if (next) {
      try {
        await axios.post(`${API}/api/test-sos`, { busId: busIdRef.current });
        console.log('SOS notification sent to all parents ✅');
      } catch (err) {
        console.log('SOS notification error:', err.message);
      }
    }

    Alert.alert('SOS', next ? '🚨 Emergency sent to all parents!' : 'SOS cancelled');
  }, [sosActive, user]);

  const formatTime = s => {
    const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
    return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
  };

  const speedColor = speed > 60 ? '#F44336' : speed > 40 ? '#FF9800' : '#00D4AA';
  const stops = route?.stops || [];

  // ── Bus display: 3 states, per spec — never a raw UUID ──
  // none    → driver has no busId at all
  // ok      → busId exists and we successfully loaded the Bus row
  // error   → busId exists but the Bus row couldn't be loaded/matched
  const busDisplayState = !busId ? 'none' : (busInfo ? 'ok' : (busFetchFailed ? 'error' : 'loading'));
  const busNoText = busInfo?.busNo || busInfo?.bus_no || null;

  const turnLabel = nextTurn
    ? (nextTurn.modifier?.indexOf('left') !== -1 ? '⬅ TURN LEFT' : 'TURN RIGHT ➡')
    : null;
  const turnDistText = nextTurn
    ? (nextTurn.distM >= 1000 ? `${(nextTurn.distM/1000).toFixed(1)} km` : `${nextTurn.distM} m`)
    : null;
  const turnColor = nextTurn?.modifier?.indexOf('left') !== -1 ? '#8B5CF6' : '#FF9800';

  const DriverMapView = useCallback(({ wvRef, onLoad }) => (
    <View style={StyleSheet.absoluteFill}
      onStartShouldSetResponder={() => false}
      onMoveShouldSetResponder={() => false}>
      <WebView
        ref={wvRef}
        source={{ html: DRIVER_MAP_HTML }}
        style={{ flex: 1 }}
        javaScriptEnabled domStorageEnabled
        scrollEnabled={false} nestedScrollEnabled={false}
        originWhitelist={['*']} mixedContentMode="always"
        allowsInlineMediaPlayback androidLayerType="hardware"
        androidHardwareAccelerationDisabled={false}
        startInLoadingState={false} bounces={false} overScrollMode="never"
        onLoadEnd={onLoad}
        onError={e => console.log('MapErr:', e.nativeEvent)}
      />
    </View>
  ), []);

  return (
    <SafeAreaView style={s.container}>
      <StatusBar barStyle="light-content" backgroundColor="#0A0F1C" />

      {/* FULLSCREEN MODAL */}
      <Modal visible={isFullscreen} animationType="fade" statusBarTranslucent onRequestClose={() => setIsFullscreen(false)}>
        <View style={s.fsContainer}>
          <DriverMapView wvRef={fsWebViewRef} onLoad={onFsMapLoad} />
          <TouchableOpacity style={s.fsClose} onPress={() => setIsFullscreen(false)}>
            <Text style={s.fsCloseTxt}>✕</Text>
          </TouchableOpacity>
          <View style={[s.speedBadge, { borderColor: speedColor }]}>
            <Text style={[s.speedBadgeTxt, { color: speedColor }]}>⚡ {speed} km/h</Text>
          </View>
        </View>
      </Modal>

      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>

        {/* HEADER */}
        <View style={s.header}>
          <View>
            <Text style={s.greeting}>Good Morning 👋</Text>
            <Text style={s.driverName}>{user?.name || 'Driver'}</Text>
            {busDisplayState === 'ok' && (
              <Text style={s.headerBusLine}>🚌 {busNoText}</Text>
            )}
            {busDisplayState === 'error' && (
              <Text style={[s.headerBusLine, { color: '#F59E0B' }]}>🚌 Bus Assigned</Text>
            )}
            {busDisplayState === 'none' && (
              <Text style={[s.headerBusLine, { color: '#F59E0B' }]}>⚠ No Bus Assigned</Text>
            )}
          </View>
          <View style={[s.connBadge, {
            backgroundColor: connected ? '#00D4AA15' : '#EF444415',
            borderColor     : connected ? '#00D4AA'   : '#EF4444',
          }]}>
            <View style={[s.connDot, { backgroundColor: connected ? '#00D4AA' : '#EF4444' }]} />
            <Text style={[s.connTxt, { color: connected ? '#00D4AA' : '#EF4444' }]}>
              {connected ? 'LIVE' : 'OFFLINE'}
            </Text>
          </View>
        </View>

        {/* GPS STATUS BANNER */}
        {tripStarted && (
          <View style={[s.gpsBanner, {
            backgroundColor: bgActive ? '#00D4AA18' : '#1A73E818',
            borderColor    : bgActive ? '#00D4AA50' : '#1A73E850',
          }]}>
            <Text style={{ fontSize: 18 }}>{bgActive ? '📡' : '🟢'}</Text>
            <View style={{ flex: 1 }}>
              <Text style={[s.gpsBannerTitle, { color: bgActive ? '#00D4AA' : '#1A73E8' }]}>
                {bgActive ? 'Background GPS Active' : 'GPS Active'}
              </Text>
              <Text style={s.gpsBannerSub}>
                {bgActive
                  ? 'App band hone pe bhi location ja rahi hai ✓'
                  : `Parents ko location mil rahi hai • ${updateCount} updates`}
              </Text>
            </View>
            <View style={[s.pingBadge, { backgroundColor: bgActive ? '#00D4AA' : '#1A73E8' }]}>
              <Text style={s.pingTxt}>{updateCount}</Text>
            </View>
          </View>
        )}

        {/* NEXT TURN BANNER (only while a trip is active and a turn is ahead) */}
        {tripStarted && nextTurn && (
          <View style={[s.turnBanner, { backgroundColor: turnColor + '22', borderColor: turnColor }]}>
            <Text style={[s.turnBannerLabel, { color: turnColor }]}>{turnLabel}</Text>
            <Text style={[s.turnBannerDist, { color: turnColor }]}>{turnDistText}</Text>
          </View>
        )}

        {/* MAP */}
        <View style={s.mapBox}>
          <DriverMapView wvRef={webViewRef} onLoad={onMapLoad} />

          <View style={[s.speedBadge, { borderColor: speedColor }]}>
            <Text style={[s.speedBadgeTxt, { color: speedColor }]}>⚡ {speed} km/h</Text>
          </View>

          {tripStarted && accuracy != null && (
            <View style={s.accBadge}>
              <Text style={s.accTxt}>📡 ±{accuracy}m</Text>
            </View>
          )}

          {tripStarted && (
            <View style={[s.tripBadge, {
              backgroundColor: bgActive ? 'rgba(0,212,170,0.15)' : 'rgba(26,115,232,0.15)',
              borderColor    : bgActive ? '#00D4AA' : '#1A73E8'
            }]}>
              <View style={[s.tripDot, { backgroundColor: bgActive ? '#00D4AA' : '#1A73E8' }]} />
              <Text style={[s.tripBadgeTxt, { color: bgActive ? '#00D4AA' : '#1A73E8' }]}>
                {bgActive ? 'BG ACTIVE' : 'TRIP ACTIVE'}
              </Text>
            </View>
          )}

          <TouchableOpacity style={s.fsBtn} onPress={() => setIsFullscreen(true)} activeOpacity={0.85}>
            <Text style={s.fsBtnTxt}>⛶</Text>
          </TouchableOpacity>
        </View>

        {/* NEXT STOP + PROGRESS */}
        {tripStarted && stops.length > 0 && (
          <View style={s.nextStopCard}>
            <View style={{ flex: 1 }}>
              <Text style={s.nextStopLbl}>NEXT STOP</Text>
              <Text style={s.nextStopName}>{nextStopInfo?.name || stops[0]?.name}</Text>
              {nextStopInfo && (
                <Text style={s.nextStopMeta}>
                  {nextStopInfo.distM >= 1000 ? `${(nextStopInfo.distM/1000).toFixed(1)} km` : `${nextStopInfo.distM} m`}
                  {nextStopInfo.etaMin ? ` • ${nextStopInfo.etaMin} min` : ''}
                </Text>
              )}
            </View>
            <View style={s.progressPill}>
              <Text style={s.progressPillTxt}>{stopProgress.done} / {stopProgress.total} STOPS</Text>
            </View>
          </View>
        )}

        {/* BUS INFO */}
        <View style={s.infoCard}>
          <Text style={s.infoLbl}>ASSIGNED BUS</Text>
          {busDisplayState === 'ok' && (
            <>
              <Text style={s.busNo}>{busNoText}</Text>
              <Text style={s.busSub}>
                {stops.length > 0 ? `${stops.length} Stops` : 'No stops assigned to this bus'}
              </Text>
            </>
          )}
          {busDisplayState === 'error' && (
            <>
              <Text style={[s.busNo, { color: '#F59E0B' }]}>Bus Assigned</Text>
              <Text style={s.busSub}>Unable to load bus details</Text>
            </>
          )}
          {busDisplayState === 'loading' && (
            <Text style={s.busSub}>Loading bus details…</Text>
          )}
          {busDisplayState === 'none' && (
            <>
              <Text style={[s.busNo, { color: '#F59E0B' }]}>⚠ No Bus Assigned</Text>
              <Text style={s.busSub}>Admin ko batao apna account bus se link karwane ke liye.</Text>
            </>
          )}
        </View>

        {/* TRIP UI */}
        {tripStarted ? (
          <View style={s.tripActive}>
            <View style={[s.speedometer, { borderColor: speedColor + '55' }]}>
              <Text style={[s.speedNum, { color: speedColor }]}>{speed}</Text>
              <Text style={s.speedUnit}>km/h</Text>
              <View style={[s.speedBar, { backgroundColor: speedColor }]} />
            </View>
            <View style={[s.speedLabel, { backgroundColor: speedColor + '22' }]}>
              <Text style={[s.speedLabelTxt, { color: speedColor }]}>
                {speed > 60 ? '🔴 OVERSPEED! Slow Down!' : speed > 40 ? '🟡 Moderate Speed' : '🟢 Safe Speed'}
              </Text>
            </View>
            <View style={s.statsRow}>
              <View style={s.statCard}>
                <Text style={s.statVal}>{formatTime(tripTime)}</Text>
                <Text style={s.statLbl}>Trip Time</Text>
              </View>
              <View style={s.statCard}>
                <Text style={s.statVal}>{updateCount}</Text>
                <Text style={s.statLbl}>GPS Pings</Text>
              </View>
              <View style={s.statCard}>
                <Text style={s.statVal}>{accuracy ? `±${accuracy}m` : '--'}</Text>
                <Text style={s.statLbl}>Accuracy</Text>
              </View>
            </View>
            <TouchableOpacity style={s.endBtn} onPress={stopTrip} activeOpacity={0.85}>
              <Text style={s.endBtnTxt}>⏹  End Trip</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[s.sosBtn, sosActive && s.sosBtnActive]} onPress={triggerSOS} activeOpacity={0.85}>
              <Text style={[s.sosTxt, sosActive && { color: '#fff' }]}>
                🆘 {sosActive ? 'SOS ACTIVE — Tap to Cancel' : 'SOS Emergency'}
              </Text>
            </TouchableOpacity>
          </View>
        ) : (
          <View style={s.preTrip}>
            <Text style={s.busBig}>🚌</Text>
            <Text style={s.readyTitle}>Ready to start?</Text>
            <Text style={s.readySub}>
              Ek baar START dabao{'\n'}
              App band hone pe bhi location chalti rahegi 📡
            </Text>
            <TouchableOpacity
              style={[s.startBtn, startingTrip && { opacity: 0.6 }]}
              onPress={startTrip}
              disabled={startingTrip}
              activeOpacity={0.85}
            >
              <Text style={s.startBtnTxt}>
                {startingTrip ? '⏳ Starting...' : '▶  START TRIP'}
              </Text>
            </TouchableOpacity>
          </View>
        )}

        <TouchableOpacity style={s.logoutBtn} onPress={async () => { await stopTrip(); await logout(); onLogout(); }}>
          <Text style={s.logoutTxt}>Logout</Text>
        </TouchableOpacity>
      </ScrollView>
    </SafeAreaView>
  );
}

