<script>
var map=L.map('map',{
  zoomControl:true,attributionControl:true,
  tap:true,tapTolerance:30,touchZoom:true,pinchZoom:true,
  bounceAtZoomLimits:false,zoomSnap:0.1,zoomDelta:0.5,
  wheelPxPerZoomLevel:40,wheelDebounceTime:15,
