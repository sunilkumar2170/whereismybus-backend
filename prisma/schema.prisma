// Public OSRM demo router — free, no key, but rate-limited and NOT an
// SLA'd production service. Fine for now; if you outgrow it, swap this
// URL for your own OSRM instance, Mapbox Directions, or Google Directions
// — the fetchRoadRoute() function below is the only place that changes.
const OSRM_ROUTE_URL = 'https://router.project-osrm.org/route/v1/driving/';

const STOP_ARRIVAL_RADIUS_M = 50;   // within this = stop counted as reached
const TURN_ARRIVAL_RADIUS_M = 30;   // within this = turn counted as taken
const OFF_ROUTE_THRESHOLD_M = 80;   // further than this from the road route = off-route
const OFF_ROUTE_CONFIRM_PINGS = 3;  // consecutive off-route pings before we act (avoids GPS-jitter false alarms)
const RECALC_COOLDOWN_MS = 30000;   // don't hit the routing API more than once per 30s

const toRad = v => (v * Math.PI) / 180;
function distMeters(lat1, lng1, lat2, lng2) {
  const R = 6371000;
  const dLat = toRad(lat2 - lat1), dLng = toRad(lng2 - lng1);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
// Approximate distance from a point to a polyline as the distance to its
// nearest vertex. OSRM returns dense enough points for city-scale routes
// that this is a fair approximation without doing full segment projection.
function distToPolylineMeters(lat, lng, coords) {
  if (!coords || !coords.length) return Infinity;
  let min = Infinity;
  for (let i = 0; i < coords.length; i++) {
    const d = distMeters(lat, lng, coords[i][0], coords[i][1]);
    if (d < min) min = d;
  }
  return min;
}

let _bgSocket = null;
// ── module-level busId ref — TaskManager.defineTask runs OUTSIDE the
// component so it can't read component state. We keep the current
// driver's busId here and update it whenever the driver logs in / trip
// starts, so the background task always sends the correct bus's GPS.
let _bgBusId = 'BUS001';

// ─── BACKGROUND TASK ───
// Yeh tab bhi chalega jab app bilkul band ho
TaskManager.defineTask(LOCATION_TASK, async ({ data, error }) => {
  if (error) { console.log('[BG ERR]', error.message); return; }
  if (!data?.locations?.length) return;
  const loc = data.locations[0];
  const { latitude, longitude, speed, heading } = loc.coords;
  const kmh = speed != null && speed >= 0 ? Math.round(speed * 3.6) : 0;
  const busId = _bgBusId || 'BUS001';

  if (_bgSocket?.connected) {
    _bgSocket.emit('sendLocation', {
      busId, lat: latitude, lng: longitude, speed: kmh, heading,
    });
    console.log('[BG] Sent:', busId, latitude, longitude, kmh + 'km/h');
  } else {
    try {
      await axios.post(`${API}/api/buses/location`, {
        busId, lat: latitude, lng: longitude, speed: kmh, heading,
      });
      console.log('[BG HTTP] Sent:', busId, latitude, longitude);
    } catch (e) {
      console.log('[BG HTTP] Failed:', e.message);
    }
  }
});

